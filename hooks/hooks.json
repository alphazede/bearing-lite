{
  "description": "Bearing Lite verified Claude Code and Codex mapping. Partial coverage: activation on SessionStart, closeout and the advisory git-sync on Stop, and the Test Engineering classes te_test_write on PreToolUse and te_completion on Stop and SubagentStop. The assurance_dispatch budget barrier runs on PreToolUse before a bound assurance launch (Bash, Task, or Agent) and denies an exhausted, unrecorded, or invalid allowance. Other transition-order checks and protected-action remain procedural.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/com.anthropic.claude-code/host.cjs\"",
            "timeout": 15,
            "statusMessage": "Bearing Lite activation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/te-host.cjs\"",
            "timeout": 15,
            "statusMessage": "Bearing Lite test-engineering write check"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator-write-lock.cjs\"",
            "timeout": 15,
            "statusMessage": "Bearing Lite orchestrator write-set lock"
          }
        ]
      },
      {
        "matcher": "Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/assurance-dispatch.cjs\"",
            "timeout": 15,
            "statusMessage": "Bearing Lite assurance budget barrier"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/com.anthropic.claude-code/host.cjs\"",
            "timeout": 15,
            "statusMessage": "Bearing Lite closeout"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/te-host.cjs\"",
            "timeout": 15,
            "statusMessage": "Bearing Lite test-engineering completion check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/git-sync.cjs\"",
            "timeout": 15,
            "statusMessage": "Bearing Lite closeout git-sync"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/te-host.cjs\"",
            "timeout": 15,
            "statusMessage": "Bearing Lite test-engineering child completion check"
          }
        ]
      }
    ]
  }
}
